{
  "id": "word-count",
  "name": "Word count",
  "version": "1.0.0",
  "description": "A sample workspace extension: a Word count view for the note on show.",
  "main": "index.js",
  "activationEvents": ["onView:wordCount", "onCommand:wordCount.show"],
  "permissions": {
    "files:read": { "paths": ["**/*.md"], "why": "Count the words in the note on show" }
  },
  "contributes": {
    "commands": [{ "command": "wordCount.show", "title": "Show word count" }],
    "views": { "sidebar": [{ "id": "wordCount", "name": "Word count" }] }
  }
}
