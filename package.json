{
  "name": "common-ink-v2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A minimal, keyboard-first workspace for markdown notes, built for people and agents.",
  "bin": {
    "common-ink": "bin/common-ink"
  },
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "build": "vite build web --outDir ../dist --emptyOutDir",
    "seed": "node --import tsx scripts/write-seed.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy": "npm run build && wrangler deploy -c worker/wrangler.jsonc",
    "preview": "npm run build && npm run seed && wrangler preview -c worker/wrangler.jsonc",
    "cli": "tsx scripts/cli.ts",
    "test:browser": "npm run build && npm run seed && node --disable-warning=ExperimentalWarning --import tsx --test --test-shard=${SHARD:-1/1} \"test/browser/*.browser.ts\"",
    "probe": "node --disable-warning=ExperimentalWarning --import tsx scripts/probe.ts",
    "net:record": "node --disable-warning=ExperimentalWarning --import tsx scripts/net-record.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.7.2",
    "@replit/codemirror-vim": "^6.4.0",
    "jose": "^6.2.12",
    "katex": "^0.19.0",
    "node-diff3": "^3.2.1",
    "three": "^0.186.1",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  }
}
