{
  "id": "calendar",
  "name": "Calendar",
  "version": "1.0.0",
  "description": "Your Google Calendar's coming days, recurring events included.",
  "main": "index.ts",
  "files": ["index.ts"],
  "activationEvents": ["onView:calendar", "onCommand:calendar.show", "onCommand:google.connect"],
  "permissions": {
    "calendar:read": { "why": "Show your events, which the Common Ink server reads from Google Calendar" }
  },
  "contributes": {
    "commands": [
      { "command": "calendar.show", "title": "Show calendar" },
      { "command": "google.connect", "title": "Connect Google calendar and contacts" }
    ],
    "views": { "sidebar": [{ "id": "calendar", "name": "Calendar" }] },
    "configuration": {
      "title": "Calendar",
      "properties": {
        "calendar.days": { "type": "integer", "default": 14, "minimum": 1, "maximum": 60, "description": "How many days ahead the Calendar view shows." }
      }
    }
  }
}
