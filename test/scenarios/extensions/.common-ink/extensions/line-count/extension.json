{
  "id": "line-count",
  "name": "Line count",
  "version": "1.0.0",
  "description": "A test extension: how many lines the note on show has, in the status bar. It runs sandboxed, and asks before reading your notes.",
  "main": "index.js",
  "files": ["index.js"],
  "activationEvents": ["onStartup"],
  "permissions": {
    "files:read": { "paths": ["**/*.md"], "why": "Count the lines in the note on show" }
  },
  "contributes": {
    "commands": [{ "command": "lineCount.show", "title": "Show line count" }],
    "views": { "sidebar": [{ "id": "lineCount", "name": "Line count" }] },
    "statusBarItems": [{ "id": "lineCount.status", "alignment": "left", "priority": 10, "command": "lineCount.show" }]
  }
}
