{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "common-ink-v2",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  // Production is commonink.app, with Google sign-in; www redirects to it (worker/src/hosts.ts), since
  // Google returns only to addresses registered with it. It has no workers.dev address. The two custom
  // domains are named by `npm run deploy` (--domain), not as routes here: with routes, wrangler dev and
  // the browser tests would see every request as commonink.app's, and the dev user only signs in on
  // localhost. A custom domain belongs to one Worker at a time, so v1 has to let go of commonink.app
  // (moving to v1.commonink.app) before this deploys: scripts/cutover-wizard.sh walks through it.
  "workers_dev": false,
  // Each pull request's Preview is at pr-<n>-common-ink-v2.<subdomain>.workers.dev and opens signed in
  // as a dev user. Like every Worker-level setting, this takes effect when production deploys.
  "preview_urls": true,
  // The web app, built by Vite into ../dist. The Worker runs first for everything except Vite's hashed
  // scripts and styles, so every page and API call is checked for a signed-in person.
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*"]
  },
  // One Durable Object per workspace, each with its own SQLite database.
  "durable_objects": { "bindings": [{ "name": "WORKSPACE", "class_name": "Workspace" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Workspace"] }],
  // Uploads' bytes, by hash (worker/src/uploads.ts). Locally, wrangler dev keeps them on disk.
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "common-ink-v2-uploads" }],
  "observability": { "enabled": true },
  // Each Preview has its own Durable Objects, so its own notes, filled from the build's seed.json. It
  // signs you in as a dev user, so there's nothing real in it to reach, and has test levers (docs/TESTING.md).
  "previews": {
    "vars": { "SEED": "1", "DEV_USER": "preview@common-ink", "DATA_FIXTURES": "1", "LEVERS": "1" },
    "durable_objects": { "bindings": [{ "name": "WORKSPACE", "class_name": "Workspace" }] },
    // One bucket for every Preview, apart from production's. Bytes are kept by hash and each Preview's
    // uploads file names its own, so Previews only see what they uploaded.
    "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "common-ink-v2-uploads-preview" }]
  }
}
